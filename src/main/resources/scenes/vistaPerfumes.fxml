                              <ImageView fitHeight="57.0" fitWidth="62.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/user.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="36.0" styleClass="menu-button" stylesheets="@../styles/principal.css" HBox.hgrow="ALWAYS">
                           <graphic>
                              <ImageView fitHeight="57.0" fitWidth="62.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/favorito.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="36.0" styleClass="menu-button" stylesheets="@../styles/principal.css" HBox.hgrow="ALWAYS">
