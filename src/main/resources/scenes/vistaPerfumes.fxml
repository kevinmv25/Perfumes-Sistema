                              <ImageView fitHeight="57.0" fitWidth="62.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/ChatGPT%20Image%2031%20may%202026,%2007_15_39%20p.m.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Label fx:id="cantidad" prefHeight="26.0" prefWidth="22.0" text=" 0" />
                        <Button mnemonicParsing="false" onAction="#sceneCarrito" prefHeight="43.0" prefWidth="36.0" styleClass="menu-button" stylesheets="@../styles/principal.css" HBox.hgrow="ALWAYS">
                           <graphic>
                              <ImageView fitHeight="41.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/carrito.png" />
                                 </image>
                              </ImageView>
