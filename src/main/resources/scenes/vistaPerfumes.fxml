                                        <HBox alignment="CENTER_LEFT" prefHeight="70" style="-fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">

                                            <padding>
                                                <Insets left="25" right="25" />
                                            </padding>

                                            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="MARCA" />

                                            <Region HBox.hgrow="ALWAYS" />

                                            <Label style="-fx-font-size: 22;" text="+" />
                                        </HBox>

                                        <VBox prefHeight="160" spacing="15" style="-fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">

                                            <padding>
                                                <Insets left="25" right="25" top="25" />
                                            </padding>

                                            <HBox alignment="CENTER_LEFT">
                                                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="PRECIO" />

                                                <Region HBox.hgrow="ALWAYS" />

                                                <Label style="-fx-font-size: 22;" text="-" />
                                            </HBox>
                                        </VBox>

                                        <HBox alignment="CENTER_LEFT" prefHeight="70">

                                            <padding>
                                                <Insets left="25" right="25" />
                                            </padding>

                                            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="SETS" />

                                            <Region HBox.hgrow="ALWAYS" />

                                            <Label style="-fx-font-size: 22;" text="+" />
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="25" HBox.hgrow="ALWAYS">

                                    <HBox alignment="CENTER_LEFT" spacing="15">

                                        <Label style="-fx-font-size: 15; -fx-text-fill: #6E7074;" text="Ordenar por:" />

