<BorderPane prefHeight="700.0" prefWidth="1285.0" style="-fx-background-color: white;" styleClass="boton-carrito" stylesheets="@../styles/principal.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.perfume.controllers.CrearCuentaController">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white;">

            <VBox spacing="35" style="-fx-background-color: white; -fx-padding: 70 120 70 120;">

                <HBox spacing="70">

                    <VBox prefWidth="430" spacing="18">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Información Personal" />

                        <Label text="Nombre *" />
                        <TextField fx:id="txtNombre" prefHeight="42" />

                        <Label text="Apellidos *" />
                        <TextField fx:id="txtApellidos" prefHeight="42" />

                        <Label text="Sexo" />
                        <ComboBox fx:id="cbSexo" prefHeight="42" prefWidth="430" />
                    </VBox>

                    <VBox prefWidth="430" spacing="18">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Información de inicio de sesión" />

                        <Label text="Correo electrónico *" />
                        <TextField fx:id="txtCorreo" prefHeight="42" />

                        <Label text="Contraseña *" />
                        <PasswordField fx:id="txtPassword" prefHeight="42" />

                        <Label fx:id="lblFuerzaPassword" style="-fx-font-size: 14px; -fx-text-fill: #777777;" />

                        <Label text="Confirmar contraseña *" />
                        <PasswordField fx:id="txtConfirmarPassword" prefHeight="42" />
                    </VBox>

                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <Button fx:id="btnCancelar" prefHeight="47.0" prefWidth="165.0" styleClass="boton-carrito" text="Cancelar" />

                    <Button fx:id="btnCrearCuenta" prefHeight="47.0" prefWidth="175.0" styleClass="boton-carrito" text="Crear cuenta" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
